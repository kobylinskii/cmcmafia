# Значения ниже рассчитаны на запуск uvicorn прямо на хосте (postgres и redis
# доступны как localhost). В docker-compose тот же файл подключается к
# контейнеру api через env_file, но DATABASE_URL/REDIS_URL/COOKIE_SECURE там
# перекрываются блоком environment: внутри compose-сети адреса -- это имена
# сервисов (postgres/redis), а не localhost. Менять их здесь под docker не надо.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/mafia
JWT_SECRET=change-me-to-a-random-64-char-secret
BOT_SERVICE_TOKEN=change-me-to-a-random-64-char-secret
REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=["http://localhost:3000"]
MEDIA_ROOT=./media/players

# Secure-куки требуют https. При деплое по http (compose из коробки слушает
# только :80) браузер молча выбросит куку сессии и в админку не войти --
# см. переопределение COOKIE_SECURE в docker-compose.yml.
COOKIE_SECURE=true
COOKIE_DOMAIN=
# lax -- сайт и API на одном домене (site.ru + api.site.ru).
# none -- фронт и бэкенд на разных доменах (нужен HTTPS, COOKIE_SECURE=true).
COOKIE_SAMESITE=lax

# Должны совпадать со значениями SUPERADMIN_IDS / ADMIN_PHONE в .env бота
# (bot/mafia-tg-bot/.env) -- см. app/services/bootstrap_admin_service.py
SUPERADMIN_TELEGRAM_IDS_RAW=
BOOTSTRAP_ADMIN_PHONE_RAW=

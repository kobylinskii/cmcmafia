# Секреты: без этого файла `COPY . .` затаскивал backend/.env прямо в образ
# (проверено: /app/.env лежал внутри собранного cmcmafia-api). Значения
# бэкенд получает из окружения контейнера, файл в образе не нужен и не должен
# там быть -- образ уезжает в реестр, .env остаётся на хосте.
.env
.env.*
!.env.example

# Виртуальное окружение с хоста: 141 МБ мусора в образе, и скрипты в нём
# прибиты к путям хост-машины. Зависимости образ ставит сам из requirements.
.venv/

# Артефакты разработки -- в рантайме не нужны.
__pycache__/
*.pyc
.pytest_cache/
tests/
requirements-dev.txt

# Загруженные фотографии живут в volume media_players, а не в образе:
# копия внутри образа только вводит в заблуждение (её никто не читает --
# volume монтируется поверх) и растит его на вес всей галереи.
media/

BOT_TOKEN=your_bot_token_here
API_BASE_URL=http://api:8000
BOT_SERVICE_TOKEN=change-me-to-a-random-64-char-secret
# Хранилище состояний диалогов. Пустое значение -- MemoryStorage: бот будет
# работать, но незавершённые регистрации не переживут рестарт.
REDIS_URL=redis://redis:6379/0
# Как часто бот забирает у API решения админа по заявкам на вступление, сек.
CONFIRMATION_POLL_SECONDS=60

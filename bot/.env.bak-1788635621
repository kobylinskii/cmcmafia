# Локальный файл (в .gitignore). Создан для того, чтобы docker-compose вообще
# мог распарсить конфиг: без него падает даже `config`, хотя сервис бота может
# быть и не нужен. BOT_TOKEN намеренно пустой -- при попытке запустить бота
# load_config() сразу упадёт с понятным "BOT_TOKEN не задан в .env",
# а не будет молча стучаться в Telegram с мусорным токеном.
BOT_TOKEN=
API_BASE_URL=http://api:8000
BOT_SERVICE_TOKEN=local-dev-token-not-a-secret

# Все NEXT_PUBLIC_* вшиваются в бандл на этапе `npm run build` (см.
# frontend/Dockerfile). API_INTERNAL_URL читается и на сборке, и в рантайме.
# В Railway это переменные СЕРВИСА, которые Railway прокидывает в docker build
# как --build-arg.

# Абсолютный origin бэкенда для БРАУЗЕРА. Пусто -> браузер ходит на /api и
# /media того же домена, что и сайт, а сервер Next проксирует на бэкенд
# (src/app/api/[...path], src/app/media/players/[...path]). Так куки сессии
# остаются first-party и работает вход в админку. Заполнять только если фронт
# и API реально за одним доменом/прокси и проксирование не нужно.
NEXT_PUBLIC_API_URL=

# @username бота без «@» -- ссылки «Войти через Telegram».
NEXT_PUBLIC_BOT_USERNAME=

# Абсолютный origin самого сайта -- для sitemap.xml и robots.txt.
NEXT_PUBLIC_SITE_URL=https://example.ru

# Куда сервер Next.js шлёт проксируемые запросы браузера и свои SSR/ISR-запросы
# к API. На Railway приватная сеть при СБОРКЕ недоступна -> публичный URL api.
API_INTERNAL_URL=https://api.example.ru

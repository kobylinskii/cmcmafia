# Корневой .env читает docker compose: и для подстановки ${...} в
# docker-compose*.yml, и для своих переменных вроде COMPOSE_FILE.
# На сервере:  cp .env.example .env  и заполнить.
# Локально файла нет вовсе -- тогда поднимается только базовый compose,
# сайт по http://localhost, и ничего из TLS не требуется.

# Подключает продакшн-надстройку (TLS + certbot) ко всем вызовам
# `docker compose` в этом каталоге. Без этой строки `docker compose up -d`
# поднял бы nginx без сертификата -- сайт открылся бы по http, а браузер
# выбросил бы Secure-куку сессии и в админку было бы не войти.
COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# Домен сайта БЕЗ схемы и без www. Единственное место, где он задаётся:
# отсюда его берут certbot (deploy/init-tls.sh), NEXT_PUBLIC_SITE_URL и
# CORS_ORIGINS (docker-compose.prod.yml). www отдельно указывать не нужно:
# сертификат берёт его сам, если www-запись в DNS есть (см. deploy/init-tls.sh).
DOMAIN=cmcmafia.ru

# Куда Let's Encrypt напишет, если сертификат перестанет продлеваться.
LETSENCRYPT_EMAIL=

# Пароль Postgres. ЗАДАТЬ ДО ПЕРВОГО `docker compose up`: том базы
# инициализируется с этим паролем, и сменить его потом -- отдельная операция
# внутри уже поднятой базы.
#   openssl rand -hex 24
POSTGRES_PASSWORD=

# Secure-куки. true -- потому что сайт за TLS (см. COMPOSE_FILE выше).
# Оставить false можно только на стенде без сертификата.
COOKIE_SECURE=true

# Общий секрет api и frontend: им бэкенд подтверждает право сбросить кеш
# публичных страниц после правок из бота (подтверждение регистрации, фото,
# отзыв согласия на публикацию). Без него сайт показывает прежнее до пяти
# минут -- ничего не ломается, но обещание «карточка исчезает сразу» со
# страницы /privacy перестаёт быть правдой.
#   openssl rand -hex 32
REVALIDATE_TOKEN=

# @username бота без «@» -- ссылки «Войти через Telegram» на сайте.
# Вшивается в бандл на сборке: после правки нужен
# `docker compose up -d --build frontend`.
NEXT_PUBLIC_BOT_USERNAME=
